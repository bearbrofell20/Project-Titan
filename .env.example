# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# Real environment variables always take precedence over this file.

# --- Credentials (required for live trading / authenticated calls) ---------
# Create an API key in the Kalshi web app; it gives you a key id and a
# downloadable RSA private key (a .pem/.key file). Point to that file below.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- Environment -----------------------------------------------------------
# "demo" (paper money, api at demo-api.kalshi.co) or "prod" (real money).
KALSHI_ENV=demo

# --- Safety ----------------------------------------------------------------
# true  = never submit real orders, only log intended trades (recommended).
# false = submit REAL orders. The CLI still requires --live and a typed
#         confirmation before it will trade for real.
KALSHI_DRY_RUN=true

# --- Risk limits -----------------------------------------------------------
KALSHI_MAX_CONTRACTS_PER_ORDER=10
KALSHI_MAX_POSITION_PER_MARKET=50
KALSHI_MAX_OPEN_EXPOSURE_CENTS=10000     # $100.00
KALSHI_MAX_DAILY_LOSS_CENTS=5000         # $50.00

# --- Engine ----------------------------------------------------------------
KALSHI_POLL_INTERVAL=30
